 {"t":"같이 영화 보러 [갈래요]?","en":"Do you want to go see a movie together?","m":{"en":"shall we go / do you want to go"}},
 {"t":"토요일 오후 [괜찮아요].","en":"Saturday afternoon works for me.","m":{"en":"is fine, works"}},
 {"t":"그럼 그때 [봐요]!","en":"See you then!","m":{"en":"see (you)"}}]},
{"id":"st-ko-reserve","lang":"ko","level":"중급","cat":"카페·식당","title":{"ko":"식당 예약하기","en":"Booking a restaurant"},"lines":[
